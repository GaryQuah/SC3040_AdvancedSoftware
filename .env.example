# ============================================================================
# Endurance AI Environment Configuration
# ============================================================================

# Application URLs
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000

# Supabase (Auth, PostgreSQL & Storage)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_JWT_SECRET=your-supabase-jwt-secret

# Redis Queue (Worker & Async Pipeline)
REDIS_URL=redis://localhost:6379/0

# Strava API (OAuth & Webhook Subscriptions)
STRAVA_CLIENT_ID=your_strava_client_id
STRAVA_CLIENT_SECRET=your_strava_client_secret
STRAVA_VERIFY_TOKEN=endurance_strava_verify_token

# Google Generative AI (Gemini 2.5 Flash)
# Note: If omitted, the engine uses deterministic scientific heuristic fallbacks
GOOGLE_GENERATIVE_AI_API_KEY=your_gemini_api_key
